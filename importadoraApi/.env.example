# Copiar a .env y completar. NUNCA versionar .env.
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=importadora
DB_USER=postgres
DB_PASSWORD=cambiar
APP_ENV=development
APP_PORT=3001
# Obligatorio en produccion: cadena larga y aleatoria (>= 32 caracteres)
JWT_SECRET=
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=15
CORS_ALLOWED_ORIGINS=http://localhost:5173
UPLOADS_DIR=uploads

BACKUPS_DIR=./backups
# Si pg_dump / pg_restore no estan en el PATH del servidor, indicar su ruta completa
# PG_DUMP_PATH=
# PG_RESTORE_PATH=
