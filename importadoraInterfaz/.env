# Ejemplo de variables de entorno (copiar a .env.local y ajustar). Las variables de Vite deben empezar con VITE_.

# URL del backend REST (API Go). Si no se define, usa http://localhost:3001
VITE_API_BASE_URL=http://localhost:3001
# URL base del bucket de Google Cloud Storage para imágenes de productos y marcas
VITE_STORAGE_BASE_URL=https://storage.googleapis.com/importadorapremiumonline/

# Ejemplo: wss://tu-servidor/ws 
VITE_WS_URL=wss://api.importadorapremium.com/wss2/
