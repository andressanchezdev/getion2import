# Copiar a .env y completar. NUNCA versionar .env. Tabla completa en PLAN-WEBSOCKET.md, sección 14.8
APP_ENV=development
# En Railway el puerto llega en PORT; APP_PORT solo se usa si PORT no existe
APP_PORT=3002

# La misma base de la API, con el usuario de mínimo privilegio (lo crea la migración 20261129_realtime.sql)
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=importadora
DB_USER=importadora_realtime
DB_PASSWORD=
DB_SSLMODE=disable
REALTIME_DB_MAX_CONNS=10

# Orígenes del front que pueden abrir el websocket (esquema + host + puerto; «*» solo en desarrollo)
REALTIME_ALLOWED_ORIGINS=http://localhost:5173

REALTIME_RETENTION_HOURS=48
REALTIME_MAX_REPLAY=5000
REALTIME_MAX_CLIENT_QUEUE=256
REALTIME_MAX_CONN_PER_ACTOR=5
REALTIME_PING_SEC=25
REALTIME_PONG_TIMEOUT_SEC=10
REALTIME_WATERMARK_SEC=30
REALTIME_HELLO_TIMEOUT_SEC=5
REALTIME_MAX_MESSAGE_BYTES=4096
