{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://importadora.local/realtime/contract/v1/events/audit.logged.schema.json",
  "title": "data de audit.logged",
  "type": "object",
  "required": [
    "auditId",
    "entity",
    "entityId",
    "action",
    "actor",
    "reason"
  ],
  "properties": {
    "auditId": {
      "type": "integer"
    },
    "entity": {
      "type": "string"
    },
    "entityId": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "action": {
      "type": "string"
    },
    "actor": {
      "type": "object",
      "required": [
        "type",
        "id",
        "name"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "employee",
            "admin",
            "superadmin",
            "system"
          ]
        },
        "id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        }
      }
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
