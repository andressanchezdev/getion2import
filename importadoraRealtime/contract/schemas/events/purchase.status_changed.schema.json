{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://importadora.local/realtime/contract/v1/events/purchase.status_changed.schema.json",
  "title": "data de purchase.status_changed",
  "type": "object",
  "required": [
    "entity",
    "from",
    "to",
    "lines",
    "reason"
  ],
  "properties": {
    "entity": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "purchase"
          ]
        },
        "id": {
          "type": "integer"
        },
        "version": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "from": {
      "type": "string",
      "enum": [
        "draft",
        "ordered",
        "partial",
        "received",
        "voided"
      ]
    },
    "to": {
      "type": "string",
      "enum": [
        "draft",
        "ordered",
        "partial",
        "received",
        "voided"
      ]
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "productId",
          "ordered",
          "received"
        ],
        "properties": {
          "productId": {
            "type": "integer"
          },
          "ordered": {
            "type": "integer"
          },
          "received": {
            "type": "integer"
          }
        }
      }
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
