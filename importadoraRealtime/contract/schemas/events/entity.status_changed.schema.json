{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://importadora.local/realtime/contract/v1/events/entity.status_changed.schema.json",
  "title": "data de entity.status_changed",
  "type": "object",
  "required": [
    "entity",
    "from",
    "to",
    "reason",
    "row"
  ],
  "properties": {
    "entity": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "company",
            "admin",
            "warehouse",
            "warehouse_billing",
            "doc_series",
            "location",
            "customer",
            "customer_document",
            "supplier",
            "carrier",
            "brand",
            "category",
            "model",
            "product",
            "product_code",
            "product_supplier",
            "role",
            "employee",
            "screensaver_settings"
          ]
        },
        "id": {
          "type": "integer"
        },
        "version": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "from": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "blocked",
        "pending",
        "overdue",
        "draft",
        "discontinued"
      ]
    },
    "to": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "blocked",
        "pending",
        "overdue",
        "draft",
        "discontinued"
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "row": {
      "type": "object"
    }
  }
}
