{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://importadora.local/realtime/contract/v1/events/cash_session.status_changed.schema.json",
  "title": "data de cash_session.status_changed",
  "type": "object",
  "required": [
    "entity",
    "from",
    "to",
    "openedBy",
    "closedBy",
    "totals"
  ],
  "properties": {
    "entity": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "cash_session"
          ]
        },
        "id": {
          "type": "integer"
        },
        "version": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "from": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "open",
            "closed"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "to": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ]
    },
    "openedBy": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "type",
            "id",
            "name"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "employee",
                "admin",
                "superadmin",
                "system"
              ]
            },
            "id": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "name": {
              "type": "string"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "closedBy": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "type",
            "id",
            "name"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "employee",
                "admin",
                "superadmin",
                "system"
              ]
            },
            "id": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "name": {
              "type": "string"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "totals": {
      "type": "object",
      "required": [
        "cashIn",
        "transferIn",
        "expenses",
        "expectedCash"
      ],
      "properties": {
        "cashIn": {
          "type": "number"
        },
        "transferIn": {
          "type": "number"
        },
        "expenses": {
          "type": "number"
        },
        "expectedCash": {
          "type": "number"
        }
      }
    }
  }
}
