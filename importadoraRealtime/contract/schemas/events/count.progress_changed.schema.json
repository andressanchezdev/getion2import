{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://importadora.local/realtime/contract/v1/events/count.progress_changed.schema.json",
  "title": "data de count.progress_changed",
  "type": "object",
  "required": [
    "entity",
    "items",
    "countedLines",
    "totalLines"
  ],
  "properties": {
    "entity": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "count"
          ]
        },
        "id": {
          "type": "integer"
        },
        "version": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "productId",
          "productCode",
          "location",
          "expectedQty",
          "countedQty"
        ],
        "properties": {
          "productId": {
            "type": "integer"
          },
          "productCode": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "expectedQty": {
            "type": "integer"
          },
          "countedQty": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "countedLines": {
      "type": "integer"
    },
    "totalLines": {
      "type": "integer"
    }
  }
}
