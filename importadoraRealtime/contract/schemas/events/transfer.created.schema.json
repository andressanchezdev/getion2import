{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://importadora.local/realtime/contract/v1/events/transfer.created.schema.json",
  "title": "data de transfer.created",
  "type": "object",
  "required": [
    "transfer"
  ],
  "properties": {
    "transfer": {
      "type": "object",
      "required": [
        "id",
        "serial",
        "status",
        "isPriority",
        "notes",
        "originWarehouseId",
        "destinationWarehouseId",
        "lines",
        "createdBy",
        "createdAt",
        "version"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "serial": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "in_transit",
            "received",
            "with_novelty",
            "cancelled"
          ]
        },
        "isPriority": {
          "type": "boolean"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "originWarehouseId": {
          "type": "integer"
        },
        "destinationWarehouseId": {
          "type": "integer"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "lineId",
              "productId",
              "productCode",
              "productName",
              "quantity",
              "receivedQty",
              "destinationLocation"
            ],
            "properties": {
              "lineId": {
                "type": "integer"
              },
              "productId": {
                "type": "integer"
              },
              "productCode": {
                "type": "string"
              },
              "productName": {
                "type": "string"
              },
              "quantity": {
                "type": "integer"
              },
              "receivedQty": {
                "type": "integer"
              },
              "destinationLocation": {
                "type": "string"
              }
            }
          }
        },
        "createdBy": {
          "type": "object",
          "required": [
            "type",
            "id",
            "name"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "employee",
                "admin",
                "superadmin",
                "system"
              ]
            },
            "id": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "name": {
              "type": "string"
            }
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
